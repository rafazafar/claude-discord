# ---- Discord ----------------------------------------------------------------
DISCORD_TOKEN=
DISCORD_APP_ID=
# Optional: register slash commands to one server instantly while testing.
# DEV_GUILD_ID=

# ---- Claude credential --------------------------------------------------------
# Set one or both. With both set, admins can switch live with /claude auth.
#
# API key: pay-as-you-go, OR your Max/Team plan's monthly API credits when the key
# is created in the Claude Console org linked to your plan (claim in claude.ai billing).
ANTHROPIC_API_KEY=
#
# Plan sign-in: run `claude setup-token` and paste the token. Draws on your plan's
# usage limits, not the monthly API credits. Tied to one person's account.
# CLAUDE_CODE_OAUTH_TOKEN=
#
# Which one to use when both are set (default: api_key).
# AUTH_MODE=api_key

# ---- Models -----------------------------------------------------------------
CLAUDE_MODEL=claude-opus-5-5
AMBIENT_MODEL=claude-haiku-5-5

# ---- GitHub (for bundles with the "github" capability) -------------------------
# Fine-grained PAT limited to the repos you list in bundles.json:
# Contents: read/write, Pull requests: read/write, Metadata: read.
# GITHUB_TOKEN=

# ---- MCP server secrets referenced as ${VAR} in bundles.json --------------------
# LINEAR_API_KEY=

# ---- Behaviour --------------------------------------------------------------
# Admin role/user IDs (comma-separated) in addition to anyone with Manage Server.
ADMIN_ROLE_IDS=
ADMIN_USER_IDS=
DEFAULT_TIMEZONE=Asia/Tokyo
MAX_CONCURRENT_RUNS=4
CONTEXT_MESSAGES=25
LOG_LEVEL=info
